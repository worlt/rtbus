<?xml version="1.0" encoding="utf-8"?>
<!--
  明文 http 白名单（第 29 步，替换原来的 android:usesCleartextTraffic="true"）。

  本工程自己的接口原则上使用 https；城市清单仍有一处历史明文 HTTP 地址。
  其余流量一律要求 https。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <!-- 掌上出行（朗斯）城市清单只有明文 HTTP（LenzApiClient.CITY_INDEX_URL） -->
        <domain includeSubdomains="true">222.76.217.238</domain>
    </domain-config>
</network-security-config>
